{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "ignoreDeprecations": "5.0",
    "baseUrl": ".",
    "paths": {
      "@vizx/core": ["packages/core/src/index.ts"],
      "@vizx/examples": ["packages/examples/src/index.ts"],
      "@vizx/geometry": ["packages/geometry/src/index.ts"],
      "@vizx/object-model": ["packages/object-model/src/index.ts"],
      "@vizx/resolver": ["packages/resolver/src/index.ts"],
      "@vizx/parser": ["packages/parser/src/index.ts"],
      "@vizx/interpreter": ["packages/interpreter/src/index.ts"],
      "@vizx/renderer-svg": ["packages/renderer-svg/src/index.ts"]
    },
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "types": []
  }
}
