{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@vizx/core": ["packages/core/src/index.ts"],
      "@vizx/parser": ["packages/parser/src/index.ts"],
      "@vizx/interpreter": ["packages/interpreter/src/index.ts"],
      "@vizx/renderer-svg": ["packages/renderer-svg/src/index.ts"]
    },
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true
  }
}
