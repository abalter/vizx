{
  "name": "vizx",
  "private": true,
  "version": "0.0.0",
  "description": "Experimental programmable 2D drawing language runtime.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b packages/core packages/parser packages/interpreter packages/renderer-svg packages/cli",
    "clean": "rm -rf packages/*/dist examples/*.svg",
    "demo": "tsx packages/cli/src/index.ts examples/basic.vizx examples/basic.svg"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
