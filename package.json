{
  "name": "vizx",
  "private": true,
  "version": "0.0.0",
  "description": "Experimental programmable 2D drawing language runtime.",
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22 <25",
    "npm": ">=10 <12"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "clean": "rm -rf packages/*/dist examples/*.svg",
    "demo": "tsx packages/cli/src/index.ts examples/basic.svg",
    "debug": "tsx packages/cli/src/index.ts debug",
    "examples": "tsx packages/cli/src/index.ts examples",
    "inspect": "tsx packages/cli/src/index.ts inspect",
    "test": "vitest run"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
